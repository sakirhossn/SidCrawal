# ==============================================================================
# SidCrawal Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local Next.js development:
#   cp .env.example .env.local
# Never commit `.env.local` or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URLs
# ------------------------------------------------------------------------------
# Local dev default: http://localhost:3000
# Production: Your Vercel domain (e.g., https://sidcrawal.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase (Required in Phase 2+)
# ------------------------------------------------------------------------------
# How to obtain:
# 1. Create a project at https://supabase.com/dashboard
# 2. Go to Project Settings -> API
# 3. Copy Project URL, anon (public) key, and service_role (secret) key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# SERVER-ONLY! Never prefix with NEXT_PUBLIC_ or expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 3. Isolated Browser Selection & Crawler Worker (Required in Phase 3–4)
# ------------------------------------------------------------------------------
# URL of the standalone Node.js + Playwright preview rendering service
# (e.g., Fly.io, Railway, Render, or local http://localhost:4001 during dev)
BROWSER_WORKER_URL=http://localhost:4001

# Shared HMAC/Bearer secret generated via: openssl rand -hex 32
BROWSER_WORKER_SECRET=your-browser-worker-shared-secret-placeholder

# ------------------------------------------------------------------------------
# 4. Scheduling & Dispatch — Cloudflare Workers & GitHub Actions (Phase 4)
# ------------------------------------------------------------------------------
# Shared secret validating Cron calls from Cloudflare Workers to Next.js API
# Generate via: openssl rand -hex 32
CLOUDFLARE_DISPATCH_SECRET=your-cloudflare-dispatch-secret-placeholder

# GitHub Personal Access Token (fine-grained, repo Actions write scope)
# How to obtain: GitHub -> Settings -> Developer settings -> Fine-grained tokens
GITHUB_DISPATCH_TOKEN=your-github-actions-dispatch-token-placeholder
GITHUB_REPO_OWNER=your-github-username-or-org
GITHUB_REPO_NAME=SidCrawal
GITHUB_CRAWLER_WORKFLOW_ID=crawler-worker.yml

# ------------------------------------------------------------------------------
# 5. Email Notifications — Resend (Required in Phase 5)
# ------------------------------------------------------------------------------
# How to obtain:
# 1. Sign up at https://resend.com
# 2. Verify your sending domain under Domains
# 3. Create an API key under API Keys
RESEND_API_KEY=re_your_resend_api_key_placeholder
EMAIL_FROM=SidCrawal Alerts <alerts@your-verified-domain.com>

# ------------------------------------------------------------------------------
# 6. Rate Limiting — Upstash Redis (Optional in Phase 1–2, Recommended Phase 6)
# ------------------------------------------------------------------------------
# How to obtain: Create a Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-placeholder

# ------------------------------------------------------------------------------
# 7. Worker Concurrency Tuning (Optional — safe production defaults built-in)
# ------------------------------------------------------------------------------
# Maximum concurrent Playwright Chromium renders/crawls per worker process (1–8, default 2)
WORKER_MAX_CONCURRENCY=2
# Maximum parallel jobs processed inside a single scheduled batch run (1–4, default 2)
CRAWL_CONCURRENCY=2
