{
  "name": "sidcrawal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev",
    "build": "next build --webpack",
    "build:turbopack": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "npm --prefix worker run dev",
    "worker:start": "npm --prefix worker run start",
    "worker:crawl": "npm --prefix worker run crawl:batch",
    "worker:typecheck": "npm --prefix worker run typecheck",
    "typecheck": "tsc --noEmit",
    "verify:prod": "node ./worker/node_modules/tsx/dist/cli.mjs --env-file-if-exists=.env.local scripts/verify-production-readiness.ts",
    "email:test-send": "node ./worker/node_modules/tsx/dist/cli.mjs --env-file-if-exists=.env.local scripts/test-resend-email.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "framer-motion": "^14.12.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.38.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
